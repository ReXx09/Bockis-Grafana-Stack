# Raspberry Pi Compose Stack (Fallback / alternative Betriebsart)
# Diese Datei wird nicht vom Unraid-AIO-Manager verwendet.
# Nach dem Kopieren in .env alle CHANGEME-Werte ersetzen.

# InfluxDB init
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=CHANGEME_sicheres_Passwort
# Mindestens 32 zufaellige Zeichen verwenden; dieser Admin-Token wird im
# Compose-Fallback derzeit von Grafana und Telegraf gemeinsam verwendet.
INFLUXDB_ADMIN_TOKEN=CHANGEME_openssl_rand_hex_32
INFLUXDB_ORG=home
INFLUXDB_BUCKET=homelab
INFLUXDB_RETENTION=30d

# Grafana admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGEME_sicheres_Passwort

# Ports on Raspberry Pi
INFLUXDB_PORT=8086
GRAFANA_PORT=3000
ALLOY_PORT=12345
SYSLOG_PORT=5514

# Loki stores OPNsense firewall events. Retention is configured in loki-config.yml.
# Im Compose-Netzwerk ist Loki unter diesem Namen erreichbar.
LOKI_URL=http://loki:3100

# Telegraf host labeling
TELEGRAF_HOSTNAME=raspi-stack
